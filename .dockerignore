# Keep build context small and secrets out of the image.
.git
.gitignore
.venv
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
.pytest_cache
*.pem

# Build outputs regenerated inside the image
web/node_modules
web/dist
web/public/animations

# Local render artifacts, database, scratch space
animations/output
media

# Not needed at runtime
README.md
backend/tests
public
server.py
run.sh
run_api.sh
