# Copy to .env, fill in your key, and use it either way:
#   docker run --env-file .env ...
#   set -a && source .env && set +a && ./run_api.sh
#
# IMPORTANT: no trailing comments on a value line, and no quotes around values.
# `docker --env-file` does not parse shell syntax — it takes everything after
# the first `=` literally, so `FOO=bar  # note` becomes the value "bar  # note"
# and `FOO="bar"` keeps the quotes. Comments get their own line here for that
# reason. (Shell `source` is more forgiving, but the file has to suit both.)
#
# Only BASE_URL / MODEL / API_KEY differ per provider — they all speak OpenAI's
# /chat/completions format, so the adapter is the same code.

# ---- Groq (default: hosted, free tier, fast) -------------------------------
# Key from https://console.groq.com/keys
#
# Model IDs churn — Groq retires them regularly. If you get
# "Model ... was not found", list what your account can actually see:
#   curl -s -H "Authorization: Bearer $ANIM_LLM_API_KEY" \
#     https://api.groq.com/openai/v1/models | python3 -m json.tool
#
# Verified to produce Manim that passes validation on the first attempt.
# Avoid the small reasoning models: gpt-oss-20b returns no code at all, and
# qwen3.6-27b is verbose enough to hit the token cap mid-string.
ANIM_LLM_API_KEY=gsk_replace_me
ANIM_LLM_BASE_URL=https://api.groq.com/openai/v1
ANIM_LLM_MODEL=openai/gpt-oss-120b
ANIM_LLM_PROVIDER_LABEL=groq

# ---- Ollama (free, offline, no key) ---------------------------------------
# brew install ollama && ollama pull qwen2.5-coder
# ANIM_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ANIM_LLM_MODEL=qwen2.5-coder
# ANIM_LLM_PROVIDER_LABEL=ollama

# ---- OpenAI ---------------------------------------------------------------
# ANIM_LLM_BASE_URL=https://api.openai.com/v1
# ANIM_LLM_MODEL=gpt-4o-mini
# ANIM_LLM_PROVIDER_LABEL=openai

# ---- OpenRouter (has :free models) ----------------------------------------
# ANIM_LLM_BASE_URL=https://openrouter.ai/api/v1
# ANIM_LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# ANIM_LLM_PROVIDER_LABEL=openrouter

# ---- Behaviour ------------------------------------------------------------
# ANIM_AI_PROVIDER: llm | template  (template runs offline with no model)
ANIM_AI_PROVIDER=llm
# Generation attempts per job, including validator-driven repairs.
ANIM_AI_MAX_ATTEMPTS=3
ANIM_LLM_TEMPERATURE=0.2
ANIM_LLM_TIMEOUT_SECONDS=90
# ANIM_LOG_FORMAT: json | text
ANIM_LOG_FORMAT=text

# ---- Job execution --------------------------------------------------------
# inline = render on the request thread (fine locally, times out behind a
# cloud load balancer); thread = bounded background pool (use when deployed).
ANIM_JOBS_BACKEND=inline
ANIM_JOBS_MAX_WORKERS=2
# ANIM_MAX_QUALITY: low | medium | high. Peak RSS is ~217/388/981 MB, so a
# 512 MB instance must cap this at low.
ANIM_MAX_QUALITY=high

# ---- Deployment only ------------------------------------------------------
# Point at a mounted disk rather than the container filesystem.
# ANIM_OUTPUT_DIR=/data
# Serve the built Vue app from the API process.
# ANIM_STATIC_DIR=/srv/web/dist
# ANIM_CORS_ALLOW_ORIGINS=https://your-frontend.example
