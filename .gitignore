*.pem
__pycache__/
.vscode/
.pytest_cache/

# Local secrets. .env.example is the committed template and holds no real key.
.env
.env.*
!.env.example

# Python virtual environment (local only; recreate from requirements.txt)
.venv/

# Manim scratch/render tree (rendered artifacts live in animations/output/)
media/

# Render artifacts, the served library, and the job metadata database
# (all regenerable via the render pipeline; keep the folder)
animations/output/*
!animations/output/.gitkeep

# Rendered videos copied into the Vue app for serving (regenerable)
web/public/animations/*
!web/public/animations/.gitkeep
